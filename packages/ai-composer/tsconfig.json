{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@sun-world/base-ui": ["../base-ui/src/index.ts"],
      "@sun-world/base-ui/*": [
        "../base-ui/src/*",
        "../base-ui/src/components/*/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}

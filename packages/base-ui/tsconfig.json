{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@sun-world/base-ui/components": ["src/components"],
      "@sun-world/base-ui/components/*": ["src/components/*"],
      "@sun-world/base-ui/lib": ["src/lib"],
      "@sun-world/base-ui/lib/*": ["src/lib/*"],
      "@sun-world/base-ui/hooks": ["src/hooks"],
      "@sun-world/base-ui/hooks/*": ["src/hooks/*"]
    },
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "types": ["vitest/globals", "node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules", "src/**/*.spec.*", "src/test/**"]
}

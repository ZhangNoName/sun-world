{
  "name": "@sun-world/icons",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/icons.es.js",
  "module": "dist/icons.es.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "vite build --mode lib",
    "dev": "vite",
    "test": "vitest run",
    "build:preview": "vite build --mode preview"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/icons.es.js",
      "default": "./dist/icons.es.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.es.js",
      "default": "./dist/core.es.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.es.js",
      "default": "./dist/react.es.js"
    },
    "./dist/*": "./dist/*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^24.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}

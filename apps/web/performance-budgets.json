{
  "$schema": "../../docs/schemas/web-performance-budgets.schema.json",
  "distDir": "apps/web/dist",
  "budgets": [
    {
      "name": "total-js-gzip",
      "type": "total",
      "extensions": [".js"],
      "maxGzipKiB": 1360
    },
    {
      "name": "total-css-gzip",
      "type": "total",
      "extensions": [".css"],
      "maxGzipKiB": 50
    },
    {
      "name": "largest-asset-gzip",
      "type": "largest",
      "extensions": [".js", ".css"],
      "maxGzipKiB": 450
    },
    {
      "name": "entry-module-gzip",
      "type": "entry",
      "maxGzipKiB": 180
    },
    {
      "name": "video-page-gzip",
      "type": "pattern",
      "pattern": "assets/VideoPage*.js",
      "maxGzipKiB": 220
    },
    {
      "name": "tile-export-gzip",
      "type": "pattern",
      "pattern": "assets/jszip.min*.js",
      "maxGzipKiB": 30
    },
    {
      "name": "article-editor-page-gzip",
      "type": "pattern",
      "pattern": "assets/ArticleEditorPage*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "admin-charts-page-gzip",
      "type": "pattern",
      "pattern": "assets/AdminChartsPage*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "admin-metrics-page-gzip",
      "type": "pattern",
      "pattern": "assets/AdminMetricsPage*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "admin-logs-page-gzip",
      "type": "pattern",
      "pattern": "assets/ManageLogsDataPage*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "login-page-gzip",
      "type": "pattern",
      "pattern": "assets/login*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "register-page-gzip",
      "type": "pattern",
      "pattern": "assets/register*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "account-page-gzip",
      "type": "pattern",
      "pattern": "assets/me*.js",
      "maxGzipKiB": 1
    },
    {
      "name": "keep-page-gzip",
      "type": "pattern",
      "pattern": "assets/keep*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "tools-page-gzip",
      "type": "pattern",
      "pattern": "assets/tools.page*.js",
      "maxGzipKiB": 1
    },
    {
      "name": "qq-callback-page-gzip",
      "type": "pattern",
      "pattern": "assets/qqCb*.js",
      "maxGzipKiB": 1
    }
  ]
}

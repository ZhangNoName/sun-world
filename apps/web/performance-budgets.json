{
  "$schema": "../../docs/schemas/web-performance-budgets.schema.json",
  "distDir": "apps/web/dist",
  "budgets": [
    {
      "name": "total-js-gzip",
      "type": "total",
      "extensions": [".js"],
      "maxGzipKiB": 1200
    },
    {
      "name": "total-css-gzip",
      "type": "total",
      "extensions": [".css"],
      "maxGzipKiB": 30
    },
    {
      "name": "largest-asset-gzip",
      "type": "largest",
      "extensions": [".js", ".css"],
      "maxGzipKiB": 450
    },
    {
      "name": "entry-index-js-gzip",
      "type": "pattern",
      "pattern": "assets/index*.js",
      "maxGzipKiB": 5
    },
    {
      "name": "react-vendor-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/vendor-react*.js",
      "maxGzipKiB": 450
    },
    {
      "name": "video-player-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/video-player*.js",
      "maxGzipKiB": 220
    },
    {
      "name": "tile-export-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/tile-export*.js",
      "maxGzipKiB": 30
    },
    {
      "name": "md-editor-preview-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/md-editor-preview*.js",
      "maxGzipKiB": 55
    },
    {
      "name": "md-editor-editor-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/md-editor-editor*.js",
      "maxGzipKiB": 22
    },
    {
      "name": "admin-charts-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/admin-charts*.js",
      "maxGzipKiB": 9
    },
    {
      "name": "admin-metrics-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/AdminMetricsPage*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "manage-shell-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/manage-shell*.js",
      "maxGzipKiB": 5
    },
    {
      "name": "page-me-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-me*.js",
      "maxGzipKiB": 1
    },
    {
      "name": "page-login-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-login*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "page-register-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-register*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "page-game-tiles-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-game-tiles*.js",
      "maxGzipKiB": 4
    },
    {
      "name": "page-keep-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-keep*.js",
      "maxGzipKiB": 2
    },
    {
      "name": "page-tools-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-tools*.js",
      "maxGzipKiB": 1
    },
    {
      "name": "page-qq-callback-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/page-qq-callback*.js",
      "maxGzipKiB": 1
    },
    {
      "name": "echarts-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/echarts*.js",
      "maxGzipKiB": 265
    },
    {
      "name": "zrender-chunk-gzip",
      "type": "pattern",
      "pattern": "assets/zrender*.js",
      "maxGzipKiB": 70
    }
  ]
}

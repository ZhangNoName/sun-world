# Runtime profile and browser origins
# ENV selects apps/api/src/conf/<ENV>.yml. It does not control cookie security.
ENV=local
# BLOG_RUNTIME_ENV controls cookie, CORS, CSRF, and public-origin security.
# Use local for local development; use production on the deployed API.
BLOG_RUNTIME_ENV=local
# Signs access and refresh JWTs. Replace this with a long random value and never commit it.
BLOG_JWT_SECRET=replace-with-a-long-random-secret
# Browser origins allowed to call the credentialed API. Comma-separated; never use *.
BLOG_CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030
# Narrower origins allowed to perform cookie-authenticated writes. Comma-separated; never use *.
# Ports 8030 and 8000 cover the root dev launcher and direct apps/api/start.sh respectively.
AUTH_CSRF_ALLOWED_ORIGINS=http://localhost:3030,http://127.0.0.1:3030,http://localhost:8030,http://127.0.0.1:8030,http://localhost:8000,http://127.0.0.1:8000
REDIS_SOCKET_TIMEOUT_SECONDS=2
MYSQL_CONNECT_TIMEOUT_SECONDS=3
MYSQL_READ_TIMEOUT_SECONDS=5
MYSQL_WRITE_TIMEOUT_SECONDS=5
# Exact externally visible API origin used to build OAuth provider callback URLs.
# Standard root launcher: http://localhost:8030. Production: https://api.sunworld.site.
AUTH_PUBLIC_API_ORIGIN=http://localhost:8030
# Canonical browser origin used after the API completes an OAuth callback.
# Local: http://localhost:3030. Production: https://sunworld.site.
AUTH_PUBLIC_WEB_ORIGIN=http://localhost:3030
# Separate HMAC secret for email/SMS verification codes; do not reuse the JWT secret in production.
AUTH_VERIFICATION_PEPPER=replace-with-a-separate-long-random-secret
# Maximum age, in seconds, of a login session allowed to connect a new identity/contact.
AUTH_STEP_UP_MAX_AGE_SECONDS=600
# Keep 0 in production. Non-zero values are rejected outside local runtime.
AUTH_REFRESH_REUSE_GRACE_SECONDS=0

# Login, registration, refresh, OTP, and OAuth abuse-control ceilings.
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_LOGIN_GLOBAL_LIMIT=3000
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_GLOBAL_LIMIT=200
AUTH_REFRESH_IP_LIMIT=120
AUTH_REFRESH_DEVICE_LIMIT=30
AUTH_REFRESH_USER_LIMIT=60
AUTH_REFRESH_GLOBAL_LIMIT=10000
AUTH_REFRESH_INVALID_GLOBAL_LIMIT=1000
AUTH_REFRESH_RATE_WINDOW_SECONDS=600
AUTH_OTP_IP_HOURLY_LIMIT=10
AUTH_OTP_TARGET_HOURLY_LIMIT=5
AUTH_OTP_TARGET_DAILY_LIMIT=10
AUTH_OTP_GLOBAL_HOURLY_LIMIT=1000
AUTH_OAUTH_START_IP_LIMIT=30
AUTH_OAUTH_START_GLOBAL_LIMIT=3000

# OAuth 2.0 / OpenID Connect applications
# Each provider is enabled only when both its client ID and client secret are non-empty.
# These are backend-only credentials: never put a client secret in apps/web/.env or VITE_*.
# Callback pattern: ${AUTH_PUBLIC_API_ORIGIN}/auth/oauth/<provider>/callback
#
# Google login uses an OAuth 2.0 Web application client, not a Google API key.
# Google local authorized redirect URI:
#   http://localhost:8030/auth/oauth/google/callback
# Google production authorized redirect URI:
#   https://api.sunworld.site/auth/oauth/google/callback
# Requested Google scopes: openid profile email. This flow does not request a phone number.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# QQ Connect application ID/key. Callback suffix: /auth/oauth/qq/callback
AUTH_QQ_CLIENT_ID=
AUTH_QQ_CLIENT_SECRET=
# WeChat Open Platform website application AppID/AppSecret. Callback suffix: /auth/oauth/wechat/callback
AUTH_WECHAT_CLIENT_ID=
AUTH_WECHAT_CLIENT_SECRET=

# Email verification delivery (STARTTLS by default)
# Email OTP is enabled when SMTP host and sender are configured. Credentials are provider-dependent.
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_FROM=
AUTH_EMAIL_SMTP_USERNAME=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_SMTP_STARTTLS=true

# SMS verification delivery through a server-side HTTPS adapter
# Phone OTP is enabled when the HTTPS webhook URL is configured; the token is optional/provider-specific.
AUTH_SMS_WEBHOOK_URL=
AUTH_SMS_WEBHOOK_TOKEN=

# AI credentials and server-approved outbound hosts
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_ALLOWED_HOSTS=api.deepseek.com,openrouter.ai,api.openai.com
AI_PROVIDER_MAX_OUTPUT_TOKENS=4096
AI_GUEST_RUN_RATE_LIMIT=20
AI_AUTHENTICATED_RUN_RATE_LIMIT=60
AI_GLOBAL_RUN_RATE_LIMIT=200
AI_RUN_RATE_WINDOW_SECONDS=600
AI_GUEST_DAILY_RUN_LIMIT=50
AI_AUTHENTICATED_DAILY_RUN_LIMIT=300
AI_GUEST_GLOBAL_DAILY_RUN_LIMIT=500
AI_GLOBAL_DAILY_RUN_LIMIT=2000
AI_GLOBAL_RUN_CONCURRENCY=8
AI_RUN_CONCURRENCY_TTL_SECONDS=240
AI_MCP_ALLOWED_HOSTS=mcp.example.com
AI_MCP_RATE_WINDOW_SECONDS=600
AI_MCP_USER_RATE_LIMIT=60
AI_MCP_IP_RATE_LIMIT=120
AI_MCP_GLOBAL_RATE_LIMIT=1000
AI_MCP_GLOBAL_CONCURRENCY=8
AI_MCP_CONCURRENCY_TTL_SECONDS=120
AI_MCP_DISCOVERY_DEADLINE_SECONDS=30
AI_MCP_CALL_DEADLINE_SECONDS=60
DEEPSEEK_API_KEY=
